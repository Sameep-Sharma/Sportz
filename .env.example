# Get your connection string from Neon Console: Project -> Dashboard -> Connect
DATABASE_URL="postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require&channel_binding=require"

# Server
PORT=8000
HOST=0.0.0.0

# Arcjet — get your key at https://arcjet.com
ARCJET_KEY="your-arcjet-key"
ARCJET_MODE=DRY_RUN

# Used by the seed script to call the REST API
API_URL="http://localhost:8000"

# Optional — real-time sports data providers
# Without these keys the server runs normally using seed data only.
FOOTBALL_DATA_API_KEY=""
CRIC_API_KEY=""
BALLDONTLIE_API_KEY=""